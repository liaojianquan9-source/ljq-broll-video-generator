{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ljq.local/schemas/layout.schema.json",
  "title": "LJQ B-roll settled layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "canvas", "settledFrame", "elements"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "caseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "settledFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "timeSeconds", "evidence"],
      "properties": {
        "frame": {"type": "integer", "minimum": 0},
        "timeSeconds": {"type": "number", "minimum": 0},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/element"}
    }
  },
  "$defs": {
    "confidence": {"enum": ["high", "medium", "low"]},
    "evidenceType": {"enum": ["measured", "observed", "inferred", "default"]},
    "bounds": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "anchor": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "detail"],
      "properties": {
        "type": {"$ref": "#/$defs/evidenceType"},
        "detail": {"type": "string", "minLength": 1},
        "frame": {"type": "integer", "minimum": 0}
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "mixBlendMode": {"type": "string", "minLength": 1},
        "blurPx": {"type": "number", "minimum": 0},
        "filter": {"type": "string"},
        "shadow": {"type": "string"},
        "borderRadiusPx": {"type": "number", "minimum": 0}
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "assetSource",
        "completeness",
        "bounds",
        "anchor",
        "cropMode",
        "zIndex",
        "appearance",
        "evidence",
        "confidence"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "type": {"enum": ["background", "group", "text", "image", "video", "shape", "line", "effect"]},
        "name": {"type": "string", "minLength": 1},
        "asset": {"type": ["string", "null"]},
        "assetSource": {"enum": ["original", "found", "extracted", "recreated"]},
        "completeness": {"enum": ["complete", "visible-only", "unknown"]},
        "bounds": {"$ref": "#/$defs/bounds"},
        "anchor": {"$ref": "#/$defs/anchor"},
        "cropMode": {"enum": ["viewport-clip", "container-mask", "asset-crop", "none"]},
        "zIndex": {"type": "integer"},
        "parentId": {"type": ["string", "null"]},
        "appearance": {"$ref": "#/$defs/appearance"},
        "replaceable": {"type": "boolean", "default": false},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    }
  }
}
