{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ljq.local/schemas/motion.schema.json",
  "title": "LJQ B-roll motion evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "caseId", "durationInFrames", "motions"],
  "properties": {
    "schemaVersion": {"enum": ["1.1", "1.2"]},
    "caseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "durationInFrames": {"type": "integer", "minimum": 1},
    "motions": {"type": "array", "items": {"$ref": "#/$defs/motion"}},
    "continuity": {"$ref": "#/$defs/continuity"}
  },
  "allOf": [
    {
      "if": {"properties": {"schemaVersion": {"const": "1.2"}}},
      "then": {"type": "object", "required": ["continuity"]}
    }
  ],
  "$defs": {
    "confidence": {"enum": ["high", "medium", "low"]},
    "evidenceType": {"enum": ["measured", "observed", "inferred", "default"]},
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "value"],
      "properties": {
        "frame": {"type": "integer", "minimum": 0},
        "value": {"type": "number"}
      }
    },
    "legacyTrack": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/keyframe"}},
    "curveTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyframes", "interpolation"],
      "properties": {
        "keyframes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/keyframe"}},
        "interpolation": {"enum": ["linear", "bezier"]},
        "bezier": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number"},
            {"type": "number", "minimum": 0, "maximum": 1},
            {"type": "number"}
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "allowReversal": {"type": "boolean"},
        "allowHoldFrames": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"interpolation": {"const": "bezier"}}},
          "then": {"type": "object", "required": ["bezier"]}
        }
      ]
    },
    "track": {"oneOf": [{"$ref": "#/$defs/legacyTrack"}, {"$ref": "#/$defs/curveTrack"}]},
    "transform": {
      "description": "Pixel translation, unitless scale, degree rotation, 0..1 opacity, and pixel blur.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "x": {"$ref": "#/$defs/track"},
        "y": {"$ref": "#/$defs/track"},
        "scaleX": {"$ref": "#/$defs/track"},
        "scaleY": {"$ref": "#/$defs/track"},
        "rotationDeg": {"$ref": "#/$defs/track"},
        "opacity": {"$ref": "#/$defs/track"},
        "blurPx": {"$ref": "#/$defs/track"}
      }
    },
    "effects": {
      "description": "Unitless CSS-style multipliers except hueRotateDeg.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "brightness": {"$ref": "#/$defs/track"},
        "contrast": {"$ref": "#/$defs/track"},
        "saturation": {"$ref": "#/$defs/track"},
        "hueRotateDeg": {"$ref": "#/$defs/track"}
      }
    },
    "reveal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "progress"],
      "properties": {
        "mode": {"enum": ["fade", "wipe", "clip", "mask", "characters", "custom"]},
        "progress": {"$ref": "#/$defs/track"},
        "direction": {"enum": ["left-to-right", "right-to-left", "top-to-bottom", "bottom-to-top", "diagonal-down-right", "diagonal-up-right", "radial", "custom"]}
      }
    },
    "textAnimation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "startFrame", "endFrame", "seed", "staggerFrames"],
      "properties": {
        "preset": {"enum": ["typewriter", "scatter-in", "wipe", "ghost-drop-in", "custom"]},
        "startFrame": {"type": "integer", "minimum": 0},
        "endFrame": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer"},
        "distancePx": {"type": "number", "minimum": 0},
        "blurPx": {"type": "number", "minimum": 0},
        "staggerFrames": {"type": "number", "minimum": 0},
        "direction": {"enum": ["top-to-bottom", "bottom-to-top", "left-to-right", "right-to-left"]},
        "ghostLayers": {"type": "integer", "minimum": 1, "maximum": 8},
        "ghostOffsetPx": {"type": "number", "minimum": 0},
        "ghostOpacity": {"type": "number", "minimum": 0, "maximum": 1},
        "stretchY": {"type": "number", "minimum": 1}
      }
    },
    "continuityWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "property", "startFrame", "endFrame", "duplicateFrames", "unexpectedReversals", "maxVelocityJump"],
      "properties": {
        "targetId": {"type": "string", "minLength": 1},
        "property": {"enum": ["x", "y", "scaleX", "scaleY", "rotationDeg"]},
        "startFrame": {"type": "integer", "minimum": 0},
        "endFrame": {"type": "integer", "minimum": 0},
        "duplicateFrames": {"type": "integer", "minimum": 0},
        "unexpectedReversals": {"type": "integer", "minimum": 0},
        "maxVelocityJump": {"type": "number", "minimum": 0}
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "windows"],
      "properties": {
        "status": {"enum": ["passed", "needs_review", "failed"]},
        "evidence": {"type": "string", "minLength": 1},
        "windows": {"type": "array", "items": {"$ref": "#/$defs/continuityWindow"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "detail"],
      "properties": {
        "type": {"$ref": "#/$defs/evidenceType"},
        "detail": {"type": "string", "minLength": 1},
        "frames": {"type": "array", "items": {"type": "integer", "minimum": 0}}
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetId", "phase", "firstVisible", "settledFrame", "endFrame", "evidence", "confidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "targetId": {"type": "string", "minLength": 1},
        "phase": {"enum": ["entrance", "hold", "emphasis", "exit", "camera", "transition"]},
        "firstVisible": {"type": "integer", "minimum": 0},
        "settledFrame": {"type": "integer", "minimum": 0},
        "endFrame": {"type": "integer", "minimum": 0},
        "transform": {"$ref": "#/$defs/transform"},
        "effects": {"$ref": "#/$defs/effects"},
        "reveal": {"$ref": "#/$defs/reveal"},
        "textAnimation": {"$ref": "#/$defs/textAnimation"},
        "easingCandidate": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "confidence": {"$ref": "#/$defs/confidence"}
      },
      "anyOf": [
        {"required": ["transform"]},
        {"required": ["effects"]},
        {"required": ["reveal"]},
        {"required": ["textAnimation"]}
      ]
    }
  }
}
